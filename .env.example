# Core application (never commit real values)
APP_ENV=production
# Production: AWS-managed RDS secret resolved in memory.
DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:rds-managed-secret
DATABASE_HOST=database.example.us-east-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=enterprise_ai_copilot
# Local development alternative:
# DATABASE_URL=sqlite:///./enterprise_ai_copilot.db
OPENAI_API_KEY=replace-me
AWS_REGION=us-east-1
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=replace-me
COGNITO_CLIENT_ID=replace-me
CORS_ALLOWED_ORIGINS=https://app.example.com
TRUSTED_HOSTS=api.example.com
RUN_SCHEMA_CREATE=false
SYNC_TOOL_CATALOG_ON_STARTUP=false
ENABLE_API_DOCS=false

# Frontend build-time public configuration
VITE_API_URL=https://api.example.com
VITE_COGNITO_USER_POOL_ID=replace-me
VITE_COGNITO_CLIENT_ID=replace-me
VITE_COGNITO_DOMAIN=example.auth.us-east-1.amazoncognito.com
VITE_AUTH_REDIRECT_URI=https://app.example.com

# Tool SDK — ServiceNow
SERVICENOW_INSTANCE_URL=https://company.service-now.com
SERVICENOW_ACCESS_TOKEN=
SERVICENOW_TIMEOUT_SECONDS=20

# Tool SDK — local files (colon-separated on Unix; semicolon-separated on Windows)
TOOL_FILE_ALLOWED_ROOTS=/absolute/approved/read-only/root
TOOL_FILE_ALLOWED_EXTENSIONS=.txt,.md,.json,.csv,.log,.yaml,.yml
TOOL_FILE_MAX_BYTES=1048576

# Tool SDK — Microsoft Graph / SharePoint / OneDrive
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_GRAPH_ACCESS_TOKEN=
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=

# Tool SDK — Azure Blob
AZURE_BLOB_ENDPOINT=https://account.blob.core.windows.net
AZURE_BLOB_ACCESS_TOKEN=
AZURE_BLOB_ALLOWED_CONTAINERS=approved-documents,reports

# Tool SDK — Azure Key Vault (metadata only in public tools)
AZURE_KEYVAULT_URI=https://vault-name.vault.azure.net
AZURE_KEYVAULT_ACCESS_TOKEN=

# Sprint 12 native tools
NATIVE_FILE_STORAGE_ROOT=/absolute/encrypted/storage/root
NATIVE_FILE_MAX_BYTES=5242880
NOTIFICATION_ALLOWED_EMAIL_DOMAINS=company.example
# Connection credentials are injected by ID; IDs are normalized to uppercase with underscores.
# NATIVE_DB_URL_<CONNECTION_ID>=postgresql+psycopg://read_only_user:secret@host/database
# NATIVE_REST_TOKEN_<CONNECTION_ID>=secret-injected-token

# Sprint 13 — Model Context Protocol
MCP_ALLOW_PRIVATE_NETWORK=false
MCP_MAX_SCHEMA_BYTES=65536
# Credential values are resolved only through env:// references.
# CUSTOMER_DATA_MCP_TOKEN=secret-injected-by-your-secret-store

# Sprint 14 — dynamic tool discovery
TOOL_DISCOVERY_EMBEDDING_PROVIDER=feature_hash
TOOL_DISCOVERY_EMBEDDING_DIMENSIONS=128
TOOL_DISCOVERY_MAX_CANDIDATES=20
TOOL_DISCOVERY_TIMEOUT_SECONDS=5
TOOL_DISCOVERY_RATE_LIMIT_PER_MINUTE=60
TOOL_DISCOVERY_INDEX_BATCH_SIZE=100
TOOL_DISCOVERY_CANDIDATE_RETENTION_DAYS=30
